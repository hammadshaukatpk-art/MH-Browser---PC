{
  "name": "mh-browser-windows",
  "version": "1.0.0",
  "private": true,
  "description": "MH Browser for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mhdevelopers.browser",
    "productName": "MH Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MH Browser",
      "artifactName": "MH-Browser-Setup-${version}.${ext}"
    }
  }
}
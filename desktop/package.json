{
  "name": "mh-browser-windows",
  "version": "1.0.0",
  "private": true,
  "description": "MH Browser for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mhdevelopers.browser",
    "productName": "MH Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "media.js",
      "preload.js",
      "ui/**",
      "README.md",
      "package.json",
      "site-media.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/mh-browser.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MH Browser",
      "artifactName": "MH-Browser-Setup-${version}.${ext}",
      "installerIcon": "build/mh-browser.ico",
      "uninstallerIcon": "build/mh-browser.ico",
      "installerHeaderIcon": "build/mh-browser.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "MH Browser — MasoomDev"
    },
    "extraResources": [
      {
        "from": "media-tools",
        "to": "media-tools",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "build/mh-browser.ico",
        "to": "mh-browser.ico"
      }
    ]
  }
}
